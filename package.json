{
  "name": "angular-electron",
  "version": "22.1.0",
  "description": "Angular 22 with Electron 44 (Typescript + SASS + Hot Reload)",
  "homepage": "https://github.com/belnadris/angular-electron",
  "author": {
    "name": "Maxime GRIS",
    "email": "maxime.gris@gmail.com"
  },
  "keywords": [
    "angular",
    "angular 22",
    "electron",
    "electron 44",
    "nodejs",
    "typescript",
    "vitest",
    "playwright",
    "eslint",
    "sass",
    "windows",
    "mac",
    "linux"
  ],
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "ng": "ng",
    "start": "npm run electron:serve",
    "ng:serve": "ng serve -c dev -o",
    "ng:serve:electron": "ng serve -c dev",
    "build": "npm run electron:serve-tsc && ng build --base-href ./",
    "web:dev": "npm run build",
    "web:prod": "npm run build -- -c production",
    "electron:serve-tsc": "tsc -p tsconfig.serve.json",
    "electron:start": "electron . --serve",
    "electron:serve": "npm run electron:serve-tsc && concurrently -k -n ng,electron \"npm:ng:serve:electron\" \"wait-on tcp:4200 && npm run electron:start\"",
    "electron:build": "npm run web:prod && electron-builder build --publish=never",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "postversion": "node -e \"const fs=require('fs');const app=JSON.parse(fs.readFileSync('./app/package.json'));app.version=require('./package.json').version;fs.writeFileSync('./app/package.json',JSON.stringify(app,null,2)+'\\n');\" && git add app/package.json"
  },
  "dependencies": {
    "@angular/cdk": "22.0.0",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/language-service": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/router": "22.1.4",
    "@ng-icons/core": "36.0.0",
    "@ng-icons/feather-icons": "36.0.0",
    "@ng-icons/lucide": "36.0.0",
    "@ng-icons/reicon": "36.0.0",
    "@spartan-ng/brain": "1.4.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/angular-charts": "0.16.0",
    "@tanstack/charts": "0.16.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "embla-carousel": ">=8.0.0 <9.0.0",
    "embla-carousel-angular": "^22.0.0",
    "ngx-scrollbar": "^19.1.5",
    "postcss": "8.5.28",
    "rxjs": "7.8.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.2.0",
    "@angular-eslint/eslint-plugin": "22.2.0",
    "@angular-eslint/eslint-plugin-template": "22.2.0",
    "@angular-eslint/schematics": "22.2.0",
    "@angular-eslint/template-parser": "22.2.0",
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@eslint/js": "10.0.1",
    "@ngx-translate/core": "18.0.0",
    "@ngx-translate/http-loader": "18.0.0",
    "@playwright/test": "1.62.1",
    "@spartan-ng/cli": "1.4.1",
    "@types/node": "26.4.1",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "angular-eslint": "22.2.0",
    "concurrently": "10.0.5",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "electron-debug": "4.1.0",
    "electron-reloader": "1.2.3",
    "eslint": "10.9.1",
    "eslint-plugin-prettier": "^5.0.1",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "prettier": "^3.0.0",
    "ts-node": "10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "typescript": ">= 6.0.0 < 6.1.0"
  },
  "browserslist": [
    "chrome 152"
  ],
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "nx@23.2.0": true,
    "electron-winstaller@5.4.0": true
  }
}
